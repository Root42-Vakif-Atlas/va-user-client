<?xml version="1.0" encoding="utf-8"?>
<!--
  Yalnızca dev flavor: yerel backend'e (docker compose) şifresiz HTTP.
  10.0.2.2 = emülatörden ana makine; localhost = `adb reverse tcp:8080 tcp:8080` ve
  `adb reverse tcp:8333 tcp:8333` (nesne deposu ön imzalı yüklemeleri). Staging/prod HTTPS zorunlu.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
